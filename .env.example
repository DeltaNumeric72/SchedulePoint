# SchedulePoint — local development environment template.
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is the only one
# tracked. No real credential ever appears here, and the secret-scan gate
# enforces that.
#
# Production secrets come from the secret store (TDG-13), never from a file.

# ---------------------------------------------------------------------------
# Database (TDG-02 / TDG-03)
# ---------------------------------------------------------------------------
# In-process pg.Pool; the unit of work pins one client per transaction.
# Statement-mode pooling is prohibited (S-03b) and asserted at process start.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=schedulepoint_dev
PGUSER=schedulepoint_app
PGPASSWORD=CHANGEME

# Roles per SPEC-01 §4. The application role is a non-owner without BYPASSRLS.
PGUSER_MIGRATION=schedulepoint_migration
PGUSER_WORKER=schedulepoint_worker

# ---------------------------------------------------------------------------
# Object store (TDG-09) — MinIO locally, S3 API in every environment
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=schedulepoint-dev
S3_ACCESS_KEY_ID=CHANGEME
S3_SECRET_ACCESS_KEY=CHANGEME

# ---------------------------------------------------------------------------
# Mail (TDG-06) — Mailpit locally. No test may reach a real destination.
# ---------------------------------------------------------------------------
SMTP_HOST=127.0.0.1
SMTP_PORT=1025

# ---------------------------------------------------------------------------
# API process
# ---------------------------------------------------------------------------
HOST=127.0.0.1
PORT=3001
NODE_ENV=development
