.DS_Store
.claude/settings.local.json
.worktrees/

# Dependencies and build output
node_modules/
dist/
dist-types/
*.tsbuildinfo

# Test and gate artifacts
#
# `.evidence-scratch/` is the NR-14 redesign (OPUS-M3-008): a plain `pnpm check`,
# `pnpm red-cases` or `pnpm sbx` writes its transcripts and retained artifacts
# here instead of over the tracked ones, so a battery run leaves the working tree
# CLEAN. `--refresh` writes the tracked paths deliberately. The old discipline —
# notice the churn and undo it with `git checkout --` — is retired.
.evidence-scratch/
coverage/
playwright-report/
test-results/
scripts/gates/request-budget/recordings/

# The tenancy harness's throwaway PostgreSQL cluster. `embedded-postgres` removes
# it on a clean stop (`persistent: false`), but a killed run leaves it behind —
# and a committed data directory would carry WAL, role password hashes and a
# fixture database into the repository.
**/.pgdata-test-*/

# Red-case fixtures are copied into the working tree while a red case runs and
# removed afterwards. If a run is interrupted, these must never be committed.
**/__red_case__*

# Local environment. Only .env.example is tracked.
.env
.env.*
!.env.example

# Python (solver/)
__pycache__/
*.py[cod]
.venv/
